# Copy to backend/.env (gitignored) before deploying.
# Loaded by Serverless (useDotenv) and injected into the Lambda environment.

# OpenRouter API key — used for both the curator (perplexity/sonar-pro) and
# editor (openai/gpt-4) models. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Amazon SES sender (must be a verified identity in this account/region).
# Defaults to no-reply@timebrew.news / "TimeBrew" if unset.
SES_FROM_EMAIL=no-reply@timebrew.news
SES_FROM_NAME=TimeBrew
